    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r -f *)",
      "Bash(rm -f -r *)",
      "Bash(rm -Rf *)",
      "Bash(rm -fR *)",
      "Bash(sudo *)"
    ]
  }
}
